# Copia este fichero a .env y rellena los valores. Nunca commitees .env.
# Documentación de cada variable: CLAUDE.md §11.

# Postgres (Docker en local: docker compose up -d)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5435/nortepalentino
# Solo en Vercel/Neon: conexión directa sin pooler, usada por `payload migrate`
# DATABASE_URL_UNPOOLED=

# Secreto de Payload (cualquier cadena larga aleatoria en local: openssl rand -hex 32)
PAYLOAD_SECRET=

# Vercel Blob. Vacío en local: los uploads se guardan en disco (/media)
BLOB_READ_WRITE_TOKEN=

# URL canónica base, sin barra final. En Vercel, si falta, se usa la URL de
# producción del proyecto (o la del despliegue en preview)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true solo en producción tras el lanzamiento. En preview se ignora (siempre noindex)
SITE_INDEXABLE=false

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_STATIC_API_KEY=

# GA4
NEXT_PUBLIC_GA_ID=

# Secreto del cron semanal de comprobación de enlaces (vercel.json). Vercel lo
# envía como Authorization: Bearer. En local no hace falta (openssl rand -hex 32)
CRON_SECRET=
