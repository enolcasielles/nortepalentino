{
  "name": "nortepalentino",
  "version": "0.1.0",
  "private": true,
  "description": "Norte Palentino: guía independiente de la Montaña Palentina",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_MIGRATING=true payload migrate && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "format": "prettier --write .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env seed/import.ts",
    "seed:prod": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.production.local seed/import.ts --remote",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ]
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-vercel-blob": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.14.2",
    "lucide-react": "^1.58.0",
    "next": "16.3.3",
    "payload": "3.91.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.10",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}
